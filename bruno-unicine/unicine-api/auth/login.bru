meta {
  name: login - POST /api/auth/login
  type: http
  seq: 2
}

vars:pre-request {
  baseUrl: http://localhost:8080
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "correo": "pepe@hotmail.com",
    "password": "78!Kz9'Aovr1>`A5"
  }
}

docs {
  200 {cedula, correo, tipo: CLIENTE, mensaje}. 401 si credenciales malas. Usa dataset dev: pepe@hotmail.com / 78!Kz9...
}
