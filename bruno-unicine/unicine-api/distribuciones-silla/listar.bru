meta {
  name: listar - GET /api/distribuciones-silla
  type: http
  seq: 1
}

vars:pre-request {
  bearer: PEGAR_ACCESS_TOKEN_DEL_LOGIN
  baseUrl: http://localhost:8080
}

get {
  url: {{baseUrl}}/api/distribuciones-silla
  auth: bearer
  token: {{bearer}}
}

docs {
  Requiere auth (layouts de sala, uso administrativo). Escritura solo ADMIN o ADMINISTRADOR_TEATRO.
}
