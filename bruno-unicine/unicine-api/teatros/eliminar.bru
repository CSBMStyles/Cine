meta {
  name: eliminar - DELETE /api/teatros/{id}?confirmacion=true
  type: http
  seq: 2
}

vars:pre-request {
  bearer: PEGAR_ACCESS_TOKEN_DEL_LOGIN
  baseUrl: http://localhost:8080
}

delete {
  url: {{baseUrl}}/api/teatros/1?confirmacion=true
  auth: bearer
  token: {{bearer}}
}

docs {
  Sin ?confirmacion -> 400 details field confirmacion. Con auth y confirmacion=false -> 409. Sin auth -> 401.
}
