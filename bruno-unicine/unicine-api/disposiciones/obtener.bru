meta {
  name: obtener - GET /api/pelicula-disposiciones/{pelicula}/{ciudad}
  type: http
  seq: 3
}

vars:pre-request {
  bearer: PEGAR_ACCESS_TOKEN_DEL_LOGIN
  baseUrl: http://localhost:8080
}

get {
  url: {{baseUrl}}/api/pelicula-disposiciones/1/1
  auth: bearer
}

auth:bearer {
  token: {{bearer}}
}

docs {
  Clave compuesta (peliculaCodigo, ciudadCodigo). 200 si existe, 404 si no.
}
