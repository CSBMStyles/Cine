meta {
  name: obtener - GET /api/compras/{id}
  type: http
  seq: 2
}

vars:pre-request {
  bearer: PEGAR_ACCESS_TOKEN_DEL_LOGIN
  baseUrl: http://localhost:8080
}

get {
  url: {{baseUrl}}/api/compras/1
  auth: bearer
  token: {{bearer}}
}

docs {
  401 sin auth, 403 si no es owner ni ADMIN, 200 si es mia, 404 si no existe
}
