meta {
  name: listar - GET /api/administradores
  type: http
  seq: 1
}

vars:pre-request {
  bearer: PEGAR_ACCESS_TOKEN_DEL_LOGIN
  baseUrl: http://localhost:8080
}

get {
  url: {{baseUrl}}/api/administradores
  auth: bearer
  token: {{bearer}}
}

docs {
  Solo rol ADMINISTRADOR. 401 sin auth, 403 sin rol, 200 con lista sin password.
}
