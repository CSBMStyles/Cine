meta {
  name: crear - POST /api/peliculas
  type: http
  seq: 2
}

vars:pre-request {
  baseUrl: http://localhost:8080
}

post {
  url: {{baseUrl}}/api/peliculas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Dune",
    "generos": ["ACCION"],
    "sinopsis": "Sinopsis Dune",
    "puntuacion": 5.0,
    "restriccionEdad": 12
  }
}

docs {
  Requiere auth. 201 con PeliculaResponse, 400 con details si body invalido.
}
