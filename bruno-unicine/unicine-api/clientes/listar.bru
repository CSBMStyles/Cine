meta {
  name: listar - GET /api/clientes
  type: http
  seq: 2
}

vars:pre-request {
  bearer: PEGAR_ACCESS_TOKEN_DEL_LOGIN
  baseUrl: http://localhost:8080
}

get {
  url: {{baseUrl}}/api/clientes
  auth: bearer
  token: {{bearer}}
}

docs {
  Solo rol ADMINISTRADOR. 401 sin auth, 403 si CLIENTE, 200 con lista sin password.
}
