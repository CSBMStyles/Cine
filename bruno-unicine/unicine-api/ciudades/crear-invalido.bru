meta {
  name: crear invalido - 400 con details
  type: http
  seq: 3
}

vars:pre-request {
  bearer: PEGAR_ACCESS_TOKEN_DEL_LOGIN
  baseUrl: http://localhost:8080
}

post {
  url: {{baseUrl}}/api/ciudades
  body: json
  auth: bearer
  token: {{bearer}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": ""
  }
}

docs {
  Debe responder 400 ApiError { status:400, details:[{field:"nombre"}] }
}
