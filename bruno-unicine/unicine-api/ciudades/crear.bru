meta {
  name: crear - POST /api/ciudades (requiere auth)
  type: http
  seq: 2
}

vars:pre-request {
  baseUrl: http://localhost:8080
}

post {
  url: {{baseUrl}}/api/ciudades
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Garzon"
  }
}

docs {
  Sin auth -> 401 ApiError DOMAIN_USER_AUTH_INVALID_CREDENTIALS. En Fase 5 anade header Authorization: Bearer <token>. Prueba error: {"nombre":""} -> 400 con details field=nombre.
}
